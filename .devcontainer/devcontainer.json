{
  "name": "YouTube Sentiment API",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  // Relance l'API à chaque démarrage du Codespace (il s'éteint après inactivité)
  "postStartCommand": "nohup python app_api.py > /tmp/api.log 2>&1 &",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Sentiment API", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
